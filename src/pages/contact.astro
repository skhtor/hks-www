---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with HKS Dance Network – enquire about classes or visit the studio.">
  <section class="contact-hero section">
    <div class="container">
      <h1>Get in Touch</h1>
      <p class="contact-intro">Whether you're interested in joining a class or just want to say hello – we'd love to hear from you.</p>
      <div class="contact-trial-cta">
        <p>Ready to jump in? Register for a free trial class – no commitment required.</p>
        <a href="https://my.classmanager.com/hks-dance-network/classes?mode=trial" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book a Free Trial</a>
      </div>
    </div>
  </section>

  <section class="contact-content section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-wrapper">
          <h2>Send an Enquiry</h2>
          <form class="contact-form" action="https://docs.google.com/forms/d/e/1FAIpQLScHjmqHW-arSIGZp1fhMms10gu0l85zGghf2cOI-CNRc7d96g/formResponse" method="POST" target="_blank">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="entry.733592847" required autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="entry.1024365079" required autocomplete="email" />
            </div>
            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="entry.1304152823" autocomplete="tel" />
            </div>
            <fieldset class="form-group form-group-checkboxes">
              <legend>Classes Interested In</legend>
              <div class="checkbox-grid">
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.1237645391" value="ԱՐԻ ՊԱՐԻ - Armenian Traditional Dance" />
                  <span>ԱՐԻ ՊԱՐԻ - Armenian Traditional Dance</span>
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.1237645391" value="Azad Gharibian Dance (AGD)" id="agd-checkbox" />
                  <span>Azad Gharibian Dance (AGD)</span>
                </label>
                <div class="agd-notice" id="agd-notice">
                  <p>🎉 AGD registrations are managed separately. Please visit the AGD website to register or enquire:</p>
                  <a href="https://agd.org.au/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-small">Visit AGD Website →</a>
                </div>
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.1237645391" value="Body Conditioning" />
                  <span>Body Conditioning</span>
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.1237645391" value="Armenian Zumba" />
                  <span>Armenian Zumba</span>
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.1237645391" value="Tiny Tots Dance & Movement" />
                  <span>Tiny Tots Dance & Movement</span>
                </label>
              </div>
            </fieldset>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="entry.1376772802" rows="5" required placeholder="Tell us a bit about yourself or your enquiry..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Enquiry</button>
            <p class="form-note">We will get back to you as soon as we can!</p>
          </form>
        </div>

        <div class="contact-info">
          <div class="info-card">
            <h3>Email</h3>
            <a href="mailto:info@hksdance.com.au" class="info-link">info@hksdance.com.au</a>
          </div>

          <div class="info-card">
            <h3>Studio</h3>
            <p>Unit 62/170 Forster Road</p>
            <p>Mount Waverley VIC 3149</p>
            <div class="map-embed">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3151.5!2d145.1265!3d-37.8765!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad66b5c5f3e1a1d%3A0x0!2s170+Forster+Rd%2C+Mount+Waverley+VIC+3149!5e0!3m2!1sen!2sau!4v1700000000000"
                width="100%"
                height="200"
                style="border:0; border-radius: 6px; margin-top: 0.75rem;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="HKS Dance Network Studio location"
              ></iframe>
            </div>
          </div>


        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    text-align: center;
    padding-bottom: 0;
  }

  .contact-intro {
    font-size: 1.15rem;
    color: var(--color-gray-200);
    max-width: 650px;
    margin: var(--space-md) auto 0;
    line-height: 1.7;
  }

  .contact-trial-cta {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 8px;
    max-width: 550px;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-trial-cta p {
    color: var(--color-gray-200);
    font-size: 1rem;
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
  }

  .contact-form-wrapper h2 {
    margin-bottom: var(--space-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gray-200);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-group-checkboxes {
    border: none;
    padding: 0;
  }

  .form-group-checkboxes legend {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gray-200);
    margin-bottom: 0.6rem;
  }

  .checkbox-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .checkbox-label:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.05);
  }

  .checkbox-label:has(input:checked) {
    border-color: var(--color-accent);
    background: rgba(212, 175, 55, 0.08);
  }

  .checkbox-label input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .checkbox-label span {
    font-size: 0.95rem;
    color: var(--color-gray-200);
  }

  .agd-notice {
    display: none;
    padding: var(--space-md);
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 6px;
    margin-top: 0.25rem;
  }

  .agd-notice.visible {
    display: block;
  }

  .agd-notice p {
    color: var(--color-gray-200);
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
    line-height: 1.5;
  }

  .btn-small {
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-note {
    font-size: 0.85rem;
    color: var(--color-gray-400);
    margin-top: 0.25rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .info-card {
    padding: var(--space-md);
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .info-card h3 {
    font-size: 0.9rem;
    margin-bottom: var(--space-xs);
    color: var(--color-accent);
  }

  .info-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-white);
  }

  .info-link-small {
    font-size: 0.9rem;
    margin-top: var(--space-sm);
    display: inline-block;
  }

  .info-card p {
    color: var(--color-gray-200);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .info-social {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .info-social a {
    color: var(--color-gray-200);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const agdCheckbox = document.getElementById('agd-checkbox');
  const agdNotice = document.getElementById('agd-notice');

  if (agdCheckbox && agdNotice) {
    agdCheckbox.addEventListener('change', () => {
      agdNotice.classList.toggle('visible', agdCheckbox.checked);
    });
  }
</script>
