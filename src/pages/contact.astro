---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with HKS Dance – enquire about classes or visit the studio.">
  <section class="contact-hero section">
    <div class="container">
      <h1>Get in Touch</h1>
      <p class="contact-intro">Whether you're interested in joining a class or just want to say hello – we'd love to hear from you.</p>
    </div>
  </section>

  <section class="contact-content section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-wrapper">
          <h2>Send an Enquiry</h2>
          <form class="contact-form" action="https://docs.google.com/forms/d/e/1FAIpQLScHjmqHW-arSIGZp1fhMms10gu0l85zGghf2cOI-CNRc7d96g/formResponse" method="POST" target="_blank">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="entry.733592847" required autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="entry.1024365079" required autocomplete="email" />
            </div>
            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="entry.1304152823" autocomplete="tel" />
            </div>
            <fieldset class="form-group form-group-checkboxes">
              <legend>Classes Interested In</legend>
              <div class="checkbox-grid">
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.487052679" value="ԱՐԻ ՊԱՐԻ - Come & Dance!" />
                  <span>ԱՐԻ ՊԱՐԻ - Come & Dance!</span>
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.487052679" value="Body Conditioning" />
                  <span>Body Conditioning</span>
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.487052679" value="Armenian Zumba" />
                  <span>Armenian Zumba</span>
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="entry.487052679" value="Tiny Tots Dance & Movement" />
                  <span>Tiny Tots Dance & Movement</span>
                </label>
              </div>
            </fieldset>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="entry.1376772802" rows="5" required placeholder="Tell us a bit about yourself or your enquiry..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Enquiry</button>
            <p class="form-note">We aim to respond within 48 hours.</p>
          </form>
        </div>

        <div class="contact-info">
          <div class="info-card">
            <h3>Email</h3>
            <a href="mailto:info@hksdance.com.au" class="info-link">info@hksdance.com.au</a>
          </div>

          <div class="info-card">
            <h3>Studio</h3>
            <p>Unit 62/170 Forster Road</p>
            <p>Mount Waverley VIC 3149</p>
          </div>

          <div class="info-card">
            <h3>Social</h3>
            <div class="info-social">
              <a href="#" target="_blank" rel="noopener noreferrer">Facebook</a>
              <a href="#" target="_blank" rel="noopener noreferrer">Instagram</a>
            </div>
          </div>

          <div class="info-card">
            <h3>Classes</h3>
            <p>Traditional Armenian Dance, AGD Choreography, Body Conditioning &amp; Mini Armenians.</p>
            <a href="/classes" class="info-link info-link-small">View Timetable →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    text-align: center;
    padding-bottom: 0;
  }

  .contact-intro {
    font-size: 1.15rem;
    color: var(--color-gray-200);
    max-width: 650px;
    margin: var(--space-md) auto 0;
    line-height: 1.7;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
  }

  .contact-form-wrapper h2 {
    margin-bottom: var(--space-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gray-200);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-group-checkboxes {
    border: none;
    padding: 0;
  }

  .form-group-checkboxes legend {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gray-200);
    margin-bottom: 0.6rem;
  }

  .checkbox-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .checkbox-label:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.05);
  }

  .checkbox-label:has(input:checked) {
    border-color: var(--color-accent);
    background: rgba(212, 175, 55, 0.08);
  }

  .checkbox-label input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .checkbox-label span {
    font-size: 0.95rem;
    color: var(--color-gray-200);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-note {
    font-size: 0.85rem;
    color: var(--color-gray-400);
    margin-top: 0.25rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .info-card {
    padding: var(--space-md);
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .info-card h3 {
    font-size: 0.9rem;
    margin-bottom: var(--space-xs);
    color: var(--color-accent);
  }

  .info-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-white);
  }

  .info-link-small {
    font-size: 0.9rem;
    margin-top: var(--space-sm);
    display: inline-block;
  }

  .info-card p {
    color: var(--color-gray-200);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .info-social {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .info-social a {
    color: var(--color-gray-200);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
