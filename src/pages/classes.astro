---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Classes" description="HKS Dance Network classes in Melbourne – Traditional Armenian dance, Body Conditioning, Armenian Zumba, and Tiny Tots Dance & Movement.">
  <section class="classes-hero section">
    <div class="container">
      <h1>Classes</h1>
      <p class="classes-intro">Something for everyone – from our tiniest dancers to adults looking to stay fit, move with purpose, and connect with culture.</p>
    </div>
  </section>

  <section class="timetable section">
    <div class="container">
      <h2>Timetable</h2>
      <div class="calendar">
        <div class="calendar-day">
          <div class="calendar-day-header">Mon</div>
          <div class="calendar-event calendar-event-proposed">
            <span class="calendar-time">7 – 8pm</span>
            <span class="calendar-class">Body Conditioning</span>
            <span class="calendar-proposed-tag">Proposed</span>
          </div>
        </div>
        <div class="calendar-day">
          <div class="calendar-day-header">Tue</div>
          <div class="calendar-event calendar-event-agd">
            <span class="calendar-time">5:45 – 6:30pm</span>
            <span class="calendar-class">AGD Juniors</span>
          </div>
          <div class="calendar-event calendar-event-agd">
            <span class="calendar-time">6:45 – 7:45pm</span>
            <span class="calendar-class">AGD Intermediates</span>
          </div>
          <div class="calendar-event calendar-event-agd">
            <span class="calendar-time">8:00 – 9:00pm</span>
            <span class="calendar-class">AGD Naz Girls</span>
          </div>
          <div class="calendar-event calendar-event-agd">
            <span class="calendar-time">8:30 – 9:30pm</span>
            <span class="calendar-class">AGD Senior Boys</span>
          </div>
        </div>
        <div class="calendar-day">
          <div class="calendar-day-header">Wed</div>
          <div class="calendar-event calendar-event-proposed">
            <span class="calendar-time">10 – 11am</span>
            <span class="calendar-class">Tiny Tots Dance & Movement</span>
            <span class="calendar-proposed-tag">Proposed</span>
          </div>
        </div>
        <div class="calendar-day">
          <div class="calendar-day-header">Thu</div>
          <div class="calendar-event">
            <span class="calendar-time">7 – 8pm</span>
            <span class="calendar-class">ԱՐԻ ՊԱՐԻ - Come & Dance!</span>
          </div>
          <div class="calendar-event calendar-event-agd">
            <span class="calendar-time">8:30 – 9:30pm</span>
            <span class="calendar-class">AGD Sirun Girls</span>
          </div>
        </div>
        <div class="calendar-day">
          <div class="calendar-day-header">Fri</div>
          <div class="calendar-event calendar-event-proposed">
            <span class="calendar-time">10 – 11am</span>
            <span class="calendar-class">Armenian Zumba</span>
            <span class="calendar-proposed-tag">Proposed</span>
          </div>
          <div class="calendar-event calendar-event-proposed">
            <span class="calendar-time">11:15am – 12:15pm</span>
            <span class="calendar-class">Body Conditioning</span>
            <span class="calendar-proposed-tag">Proposed</span>
          </div>
        </div>
        <div class="calendar-day calendar-day-weekend">
          <div class="calendar-day-header">Sat</div>
          <div class="calendar-empty"></div>
        </div>
        <div class="calendar-day calendar-day-weekend">
          <div class="calendar-day-header">Sun</div>
          <div class="calendar-empty"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="class-list section">
    <div class="container">
      <div class="class-item">
        <h2>ԱՐԻ ՊԱՐԻ - Come & Dance!</h2>
        <p class="class-subtitle">Discover Armenia's Regional Folk Dances</p>
        <p class="class-description">Discover the ancient roots of Armenian dance at HKS! Experience our incredibly rich cultural footprint through movement. Learn dances to melodies that are thousands of years old.</p>
        <p class="class-description">We welcome all ages and experience levels in a fun, supportive environment. No prior dance experience is required to join us.</p>
        <p class="class-description">Whether you want to connect with your heritage, keep ancient traditions alive, or make lasting friends, you'll find a place here. Come dance and discover the resilient spirit of Armenian culture today!</p>
        <div class="class-meta">
          <span class="class-meta-tag">All ages</span>
          <span class="class-meta-tag">All levels</span>
          <span class="class-meta-tag">No experience required</span>
        </div>
      </div>

      <div class="class-item">
        <h2>Azad Gharibian Dance (AGD)</h2>
        <p class="class-subtitle">Victoria's First Armenian Dance Group – Est. 1994</p>
        <p class="class-description">Azad Gharibian Dance (AGD) is Victoria's first and only Armenian dance group, proudly preserving and celebrating Armenian dance and culture since 1994. As a not-for-profit organisation, AGD welcomes dancers of all ages and abilities in a fun, inclusive and supportive community.</p>
        <p class="class-description">From festivals and concerts to weddings and community events across Australia, AGD proudly shares the energy, tradition and spirit of Armenian culture through dance. Join us and experience the joy of Armenian dance!</p>
        <div class="benefits">
          <h3>Groups</h3>
          <ul class="benefits-list">
            <li>Juniors</li>
            <li>Intermediates</li>
            <li>Seniors (Beginners)</li>
            <li>Seniors (Advanced)</li>
          </ul>
        </div>
        <div class="class-meta">
          <span class="class-meta-tag">All ages</span>
          <span class="class-meta-tag">All abilities</span>
          <span class="class-meta-tag">Not-for-profit</span>
        </div>
        <a href="https://agd.org.au/" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="margin-top: var(--space-md);">Visit AGD Website →</a>
      </div>

      <div class="class-item">
        <h2>Body Conditioning</h2>
        <p class="class-subtitle">Enhancing Strength, Mobility & Control</p>
        <p class="class-description">Body Conditioning is a structured, full-body class focused on strengthening and lengthening your muscles through controlled movement. Combining bodyweight strength exercises with deep stretching and mobility work, this class builds a strong, flexible foundation for everyday life.</p>
        <p class="class-description">Whether you are looking to improve for your favourite sport, build foundational strength, or simply move easier in daily life, you will find a safe, welcoming, and motivating environment. Join us to build confidence, reach your fitness goals, and leave every session feeling completely energised!</p>
        <div class="benefits">
          <h3>The Benefits</h3>
          <ul class="benefits-list">
            <li><strong>Total Body Strength:</strong> Build muscle endurance, tone, and deep core stability.</li>
            <li><strong>Enhanced Mobility:</strong> Improve your flexibility, balance, and posture.</li>
            <li><strong>Cardio Fitness:</strong> Boost your heart health, stamina, and calorie burn.</li>
            <li><strong>Injury Prevention:</strong> Condition your joints and muscles to support athletic performance and safer everyday functional movement.</li>
            <li><strong>Vitality & Confidence:</strong> Leave class feeling energized, capable, and ready to tackle your day.</li>
          </ul>
        </div>
        <div class="class-meta">
          <span class="class-meta-tag">All fitness levels</span>
          <span class="class-meta-tag">Full body workout</span>
          <span class="class-meta-tag new">New</span>
        </div>
      </div>

      <div class="class-item">
        <h2>Armenian Zumba</h2>
        <p class="class-description">All the energy of a traditional Zumba class, powered by Armenian music. Follow along with easy, fun choreography while getting a full cardio workout to the vibrant beats of both modern and classic Armenian songs.</p>
        <p class="class-description">No previous dance experience is needed! This fast-paced class is designed for all fitness levels, blending easy choreography with an unforgettable workout.</p>
        <p class="class-description">Whether you want to burn calories, boost your mood, or just dance to your favourite Armenian tunes, you'll leave feeling completely energised!</p>
        <div class="class-meta">
          <span class="class-meta-tag">All fitness levels</span>
          <span class="class-meta-tag">No experience required</span>
          <span class="class-meta-tag new">New</span>
        </div>
      </div>

      <div class="class-item">
        <h2>Tiny Tots Dance & Movement</h2>
        <p class="class-subtitle">18 months – 4 years</p>
        <p class="class-description">Designed for children aged 18 months to 4 years alongside a parent or caregiver, this fun and interactive class is the perfect first introduction to dance. Through imaginative play, lively music, and storytelling, you and your little one will explore creative movement together in a warm, welcoming environment.</p>
        <p class="class-description">It is a wonderful opportunity to bond, play, and nurture a lifelong love of physical activity.</p>
        <div class="benefits">
          <h3>The Benefits</h3>
          <ul class="benefits-list">
            <li><strong>Physical Development:</strong> Improves balance, coordination, flexibility, and both gross and fine motor skills.</li>
            <li><strong>Creative Expression:</strong> Sparks imagination and introduces early concepts of rhythm and musicality.</li>
            <li><strong>Cognitive Growth:</strong> Sharpens listening skills, concentration, and overall body awareness.</li>
            <li><strong>Social & Emotional Skills:</strong> Builds confidence, encourages independence, and helps children practice positive interaction with others.</li>
            <li><strong>Family Bonding:</strong> Creates joyful, dedicated time to connect and make lasting memories with your child.</li>
          </ul>
        </div>
        <div class="class-meta">
          <span class="class-meta-tag">18 months – 4 years</span>
          <span class="class-meta-tag">Parent & child</span>
          <span class="class-meta-tag new">New</span>
        </div>
      </div>
    </div>
  </section>

  <section class="enrol section">
    <div class="container enrol-inner">
      <h2>Ready to start?</h2>
      <p>Get in touch to learn more about class times, pricing, and availability.</p>
      <a href="/contact" class="btn btn-primary">Contact Us</a>
    </div>
  </section>
</BaseLayout>

<style>
  .classes-hero {
    text-align: center;
  }

  .classes-hero h1 {
    margin-bottom: var(--space-lg);
  }

  .classes-intro {
    font-size: 1.15rem;
    color: var(--color-gray-200);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .class-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .timetable {
    max-width: 800px;
    margin: 0 auto;
    padding-bottom: 0;
  }

  .timetable h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .calendar-day {
    background: rgba(255, 255, 255, 0.03);
    min-height: 120px;
    display: flex;
    flex-direction: column;
  }

  .calendar-day-weekend {
    opacity: 0.4;
  }

  .calendar-day-header {
    padding: 0.5rem;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-200);
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .calendar-event {
    padding: 0.5rem;
    margin: 0.4rem;
    background: rgba(139, 0, 0, 0.3);
    border-left: 3px solid var(--color-primary);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .calendar-event-agd {
    background: rgba(212, 175, 55, 0.1);
    border-left-color: var(--color-accent);
  }

  .calendar-event-proposed {
    border-left-style: dashed;
    opacity: 0.75;
  }

  .calendar-proposed-tag {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-200);
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    width: fit-content;
  }

  .calendar-time {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .calendar-class {
    font-size: 0.75rem;
    color: var(--color-white);
    line-height: 1.3;
  }

  .calendar-empty {
    flex: 1;
  }

  @media (max-width: 768px) {
    .calendar {
      grid-template-columns: 1fr;
    }

    .calendar-day {
      min-height: auto;
      flex-direction: row;
      align-items: center;
    }

    .calendar-day-header {
      min-width: 50px;
      border-bottom: none;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
    }

    .calendar-day-weekend {
      display: none;
    }

    .calendar-event {
      flex: 1;
    }

    .calendar-empty {
      padding: 0.75rem;
    }
  }

  .class-item {
    padding: var(--space-xl);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    margin-bottom: var(--space-lg);
  }

  .class-item:last-child {
    margin-bottom: 0;
  }

  .class-item h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .class-subtitle {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .class-description {
    color: var(--color-gray-200);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  .class-description:last-of-type {
    margin-bottom: var(--space-md);
  }

  .benefits {
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .benefits h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
  }

  .benefits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .benefits-list li {
    color: var(--color-gray-200);
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }

  .benefits-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .benefits-list li strong {
    color: var(--color-white);
  }

  .class-meta {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .class-meta-tag {
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-gray-200);
  }

  .class-meta-tag.new {
    background: rgba(212, 175, 55, 0.2);
    color: var(--color-accent);
    font-weight: 600;
  }

  .enrol {
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .enrol-inner h2 {
    margin-bottom: var(--space-sm);
  }

  .enrol-inner p {
    color: var(--color-gray-200);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }
</style>
