---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" description="HKS Dance Network - Armenian dance studio in Melbourne. Classes for all ages including traditional dance, body conditioning, and more." isHome>
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1>Our culture lives when we dance</h1>
      <p class="hero-subtitle">Learn dances that are thousands of years old, get fit to Armenian beats, or introduce your little ones to our culture – all in a welcoming Melbourne studio.</p>
      <div class="hero-ctas">
        <a href="/classes" class="btn btn-primary">View Classes</a>
        <a href="/about" class="btn btn-secondary">Our Story</a>
      </div>
    </div>
  </section>

  <section class="intro section">
    <div class="container">
      <h2 class="section-heading">More than a studio</h2>
      <p class="intro-text">This is where culture comes alive through movement. HKS Dance Network brings together people of all ages and backgrounds to learn, stay active, and keep Armenian traditions thriving in Australia.</p>
    </div>
  </section>

  <section class="classes section">
    <div class="container">
      <h2 class="section-heading">What we offer</h2>
      <p class="section-intro">Traditional Armenian dance, fitness, Zumba, and classes for little ones – all under one roof.</p>
      <div class="classes-cta">
        <a href="/classes" class="btn btn-primary">View Classes & Timetable →</a>
      </div>
    </div>
  </section>

  <section class="legacy section">
    <div class="container">
      <blockquote class="legacy-quote">
        "After 32 years of teaching Armenian dance in Australia, I'm proud to finally have a space to call my own – one that allows me to continue the legacy I've dedicated my life to, while growing into new areas I've always dreamed of."
      </blockquote>
      <p class="legacy-attribution">– Hermine Kuyumcian, Founder</p>
    </div>
  </section>

  <section class="cta section">
    <div class="container cta-inner">
      <h2>Join the HKS family</h2>
      <p>All ages. All levels. One community.</p>
      <a href="/contact" class="btn btn-primary">Get in Touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    background: var(--color-black);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(139, 0, 0, 0.15), rgba(10, 10, 10, 0.95));
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--color-gray-200);
    max-width: 650px;
    margin: 0 auto var(--space-xl);
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .intro {
    text-align: center;
  }

  .section-heading {
    text-align: center;
    margin-bottom: var(--space-sm);
  }

  .section-intro {
    text-align: center;
    color: var(--color-gray-200);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }

  .intro-text {
    font-size: 1.15rem;
    color: var(--color-gray-200);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
    text-align: center;
  }

  .classes-cta {
    text-align: center;
  }

  .legacy {
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .legacy-quote {
    max-width: 750px;
    margin: 0 auto var(--space-md);
    font-style: italic;
    color: var(--color-gray-200);
    font-size: 1.15rem;
    line-height: 1.8;
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-lg);
    text-align: left;
  }

  .legacy-attribution {
    color: var(--color-gray-600);
    font-weight: 600;
    text-align: left;
    max-width: 750px;
    margin: 0 auto;
    padding-left: var(--space-lg);
  }

  .cta {
    text-align: center;
  }

  .cta-inner h2 {
    margin-bottom: var(--space-sm);
  }

  .cta-inner p {
    color: var(--color-gray-200);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }
</style>
