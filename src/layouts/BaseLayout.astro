---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
}

const { title, description = 'HKS Dance Network - Armenian folk dance in Melbourne.', isHome = false } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | HKS Dance Network`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/hks-logo.png" />
    <meta property="og:site_name" content="HKS Dance Network" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | HKS Dance Network`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/hks-logo.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <ClientRouter />
    <title>{title} | HKS Dance Network</title>
  </head>
  <body>
    <Nav />
    <main id="main-content" class={isHome ? 'home' : ''}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  main {
    padding-top: var(--nav-height);
  }

  main.home {
    padding-top: 0;
  }
</style>
