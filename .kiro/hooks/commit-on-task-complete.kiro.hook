{
  "enabled": true,
  "name": "Auto Commit on Task Completion",
  "description": "Stages all changes and commits with a meaningful message based on what was implemented in the completed task",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "A spec task was just completed. Review the git diff (run `git diff --cached` and `git diff` to see staged and unstaged changes) and the task description to write a concise, meaningful commit message. Then stage all changes with `git add -A` and commit using that message. Use conventional commit format (e.g. feat:, fix:, chore:)."
  }
}
